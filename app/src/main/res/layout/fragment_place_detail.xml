<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 사진 헤더 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="#D1E5F8">

            <ImageView
                android:id="@+id/imgPlaceholder"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:contentDescription="사진 없음"
                android:src="@drawable/ic_image"
                app:tint="@color/accent" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/photoPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back"
                app:tint="#68696A" />

            <ImageButton
                android:id="@+id/btnSaveTop"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/save"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvPhotoCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/nps_font"
                android:text="1/8"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 이름 / 카테고리·지역 -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="21dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/nps_font"
            android:letterSpacing="0.01"
            android:textColor="#68696A"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="댕댕뮤지엄" />

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="21dp"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/nps_font"
            android:letterSpacing="0.01"
            android:textColor="#68696A"
            android:textSize="11sp"
            tools:text="박물관 • 서울 종로구 삼청동" />

        <!-- 저장 / 여행 일정에 추가 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="23dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_outline_accent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/icSave"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@string/save"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/accent" />

                <TextView
                    android:id="@+id/tvSaveLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/nps_font"
                    android:letterSpacing="0.01"
                    android:text="@string/save"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAddTrip"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_outline_accent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/place_add_trip"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/nps_font"
                    android:letterSpacing="0.01"
                    android:text="여행 일정에 추가"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 개요 / 정보 탭 -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            app:tabIndicatorColor="@color/accent"
            app:tabIndicatorHeight="3dp"
            app:tabMode="scrollable"
            app:tabSelectedTextColor="#68696A"
            app:tabTextColor="#68696A">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="개요" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="정보" />
        </com.google.android.material.tabs.TabLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ADADAE" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ── 개요 탭 ── -->
            <LinearLayout
                android:id="@+id/sectionOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="15dp"
                android:paddingBottom="24dp">

                <!-- 방문가능 배너 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_banner_pet"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="15dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_paw"
                        app:tint="#2F822A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/nps_font"
                        android:letterSpacing="0.02"
                        android:text="반려동물과 함께 방문 가능한 곳이에요"
                        android:textColor="#2F822A"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 주소 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingVertical="11dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_place"
                        app:tint="#68696A" />

                    <TextView
                        android:id="@+id/tvAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:fontFamily="@font/nps_font"
                        android:letterSpacing="0.01"
                        android:textColor="#68696A"
                        android:textSize="12sp"
                        tools:text="서울 종로구 삼청로 22" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#ADADAE" />

                <!-- 영업시간 -->
                <LinearLayout
                    android:id="@+id/rowHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingVertical="11dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_schedule"
                            app:tint="#68696A" />

                        <TextView
                            android:id="@+id/tvHours"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:fontFamily="@font/nps_font"
                            android:letterSpacing="0.01"
                            android:textSize="12sp"
                            tools:text="영업 중 • 18:00에 영업 종료" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#ADADAE" />
                </LinearLayout>

                <!-- 전화 -->
                <LinearLayout
                    android:id="@+id/rowPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingVertical="11dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_phone"
                            app:tint="#68696A" />

                        <TextView
                            android:id="@+id/tvPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:fontFamily="@font/nps_font"
                            android:letterSpacing="0.01"
                            android:textColor="#68696A"
                            android:textSize="12sp"
                            tools:text="02-6666-7777" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#ADADAE" />
                </LinearLayout>

                <!-- 사진 및 동영상 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/nps_font"
                    android:letterSpacing="0.01"
                    android:text="사진 및 동영상"
                    android:textColor="#68696A"
                    android:textSize="12sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="noHideDescendants"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/photoStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/photoThumb1"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:background="@drawable/bg_photo_placeholder"
                            android:scaleType="centerCrop" />

                        <ImageView
                            android:id="@+id/photoThumb2"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_photo_placeholder"
                            android:scaleType="centerCrop" />

                        <ImageView
                            android:id="@+id/photoThumb3"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_photo_placeholder"
                            android:scaleType="centerCrop" />

                        <ImageView
                            android:id="@+id/photoThumb4"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_photo_placeholder"
                            android:scaleType="centerCrop" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ── 정보 탭 (API 원문 그대로) ── -->
            <LinearLayout
                android:id="@+id/sectionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="15dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/blockSpecies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nps_font"
                        android:text="동반 가능 동물"
                        android:textColor="#68696A"
                        android:textSize="12sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:contentDescription="동반 가능 동물 목록"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/speciesContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/nps_font"
                    android:text="견종 크기"
                    android:textColor="#68696A"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/badgeSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nps_font"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="7dp"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/badgeMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/nps_font"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="7dp"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/badgeLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/nps_font"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="7dp"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowIndoor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nps_font"
                        android:text="실내/실외"
                        android:textColor="#68696A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valIndoor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/nps_font"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowFee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nps_font"
                        android:text="추가 요금"
                        android:textColor="#68696A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valFee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/nps_font"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowRestrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nps_font"
                        android:text="제한 사항"
                        android:textColor="#68696A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valRestrict"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/nps_font"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowFacility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nps_font"
                        android:text="구비 시설"
                        android:textColor="#68696A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/valFacility"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/nps_font"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>