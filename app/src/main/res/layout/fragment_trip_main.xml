<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- PawMap logo header -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_pawmap_logo"
            android:contentDescription="PawMap"
            app:tint="@color/pawmap_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="PawMap"
            android:textColor="@color/pawmap_primary"
            android:textSize="24sp"
            android:fontFamily="@font/rubik_bubbles" />
    </LinearLayout>

    <!-- ================= 히어로 일러스트 =================
         언덕(bg_02~04, 각 vector에 fill 색상 baked-in) 위에 코기 + 나무 + 구름 배치.
         나무/구름의 좌표는 Figma에서 정확한 x/y를 못 뽑아 눈대중 배치함.
         실기기·프리뷰에서 스크린샷과 비교해 margin 값 미세 조정 필요. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="4dp"
        android:clipChildren="false">

        <!-- 언덕 (뒤 → 앞 순서) -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:src="@drawable/bg_03" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="18dp"
            android:src="@drawable/bg_02" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="8dp"
            android:src="@drawable/bg_04" />

        <!-- 구름 -->
        <ImageView
            android:layout_width="42dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="28dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_cloud_01" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="24dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_cloud_02" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="14dp"
            android:src="@drawable/ic_cloud_03" />

        <!-- 나무 -->
        <ImageView
            android:layout_width="30dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_tree_03" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="43dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="36dp"
            android:src="@drawable/ic_tree_01" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="23dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_tree_02" />

        <!-- 코기 마스코트 -->
        <ImageView
            android:layout_width="200dp"
            android:layout_height="209dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="4dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_dog" />

    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/nps_font"
        android:gravity="center"
        android:letterSpacing="0.03"
        android:lineSpacingExtra="8dp"
        android:text="@string/trip_intro"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/nps_font"
        android:gravity="center"
        android:letterSpacing="0.01"
        android:text="@string/trip_intro_sub"
        android:textColor="@color/intro_sub_text"
        android:textSize="20sp" />

    <LinearLayout
        android:id="@+id/cardCreate"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icCreate"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_plus" />

        <TextView
            android:id="@+id/tvCreateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/nps_font"
            android:letterSpacing="0.01"
            android:text="@string/create_trip"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnPastTrips"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_outline_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_timer" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/nps_font"
            android:letterSpacing="0.01"
            android:text="@string/past_trips"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
