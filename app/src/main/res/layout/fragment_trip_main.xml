<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- PawMap logo header -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_pawmap_logo"
            android:contentDescription="PawMap"
            app:tint="@color/pawmap_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="PawMap"
            android:textColor="@color/pawmap_primary"
            android:textSize="24sp"
            android:fontFamily="@font/rubik_bubbles" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="257dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_header_gradient"
        android:clipChildren="false">

        <!-- Trees (가장 뒤) -->
        <ImageView
            android:layout_width="29.22dp"
            android:layout_height="47.5dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="9dp"
            android:layout_marginTop="115dp"
            android:src="@drawable/ic_tree_03" />

        <ImageView
            android:layout_width="13.84dp"
            android:layout_height="22.5dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="38dp"
            android:layout_marginTop="144dp"
            android:src="@drawable/ic_tree_02" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="42.27dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="348dp"
            android:layout_marginTop="137dp"
            android:src="@drawable/ic_tree_01" />

        <!-- Hills -->
        <ImageView
            android:layout_width="84.5dp"
            android:layout_height="62.5dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="0dp"
            android:layout_marginTop="160dp"
            android:src="@drawable/bg_04" />

        <ImageView
            android:layout_width="343.5dp"
            android:layout_height="85.4dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="0dp"
            android:layout_marginTop="171dp"
            android:src="@drawable/bg_03" />

        <ImageView
            android:layout_width="108.5dp"
            android:layout_height="77.42dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="284dp"
            android:layout_marginTop="178.08dp"
            android:src="@drawable/bg_02" />

        <!-- White content-card backdrop (behind corgi, flows down past hero) -->
        <ImageView
            android:layout_width="393dp"
            android:layout_height="447.85dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="0dp"
            android:layout_marginTop="201dp"
            android:src="@drawable/bg_01" />

        <!-- Corgi -->
        <ImageView
            android:layout_width="202.82dp"
            android:layout_height="211.02dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="103dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/logo_dog" />

        <!-- Clouds (가장 앞) -->
        <ImageView
            android:layout_width="41.18dp"
            android:layout_height="23.55dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="39dp"
            android:layout_marginTop="47dp"
            android:src="@drawable/ic_cloud_03" />

        <ImageView
            android:layout_width="41.18dp"
            android:layout_height="23.55dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="297dp"
            android:layout_marginTop="0dp"
            android:src="@drawable/ic_cloud_02" />

        <ImageView
            android:layout_width="41.18dp"
            android:layout_height="23.55dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="329dp"
            android:layout_marginTop="73dp"
            android:src="@drawable/ic_cloud_01" />

    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="@string/trip_intro"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/trip_intro_sub"
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/cardCreate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_primary_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icCreate"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_add"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvCreateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/create_trip"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnPastTrips"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_outline_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_history"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/past_trips"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>