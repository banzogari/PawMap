<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#68696A" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/nps_font"
            android:maxLines="1"
            android:text="가고 싶은 장소"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="메뉴"
            android:src="@drawable/ic_more_vert"
            app:tint="#68696A" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="17dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/nps_font"
        android:letterSpacing="0.01"
        android:text="4개 장소"
        android:textColor="#68696A"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#ADADAE" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="175dp"
                android:layout_height="141dp">

                <ImageView
                    android:layout_width="98dp"
                    android:layout_height="121dp"
                    android:layout_marginStart="17dp"
                    android:layout_marginTop="20dp"
                    android:contentDescription="저장한 장소 없음"
                    android:src="@drawable/logo_dog_empty" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="119dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bubble_bookmark" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/nps_font"
                android:letterSpacing="0.01"
                android:text="저장한 장소가 없어요"
                android:textColor="#68696A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="191dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/nps_font"
                android:gravity="center"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="6dp"
                android:text="마음에 드는 장소를 저장하고\n언제든 다시 찾아보세요!"
                android:textColor="#68696A"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>