<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp">

        <LinearLayout
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/nps_font"
                android:letterSpacing="0.01"
                android:text="@string/save"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/nps_font"
            android:letterSpacing="0.01"
            android:text="강릉·속초 여행"
            android:textColor="@color/input_hint"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/nps_font"
            android:letterSpacing="0.01"
            android:text="2026.7.27 - 7.29"
            android:textColor="@color/input_hint"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvPets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/nps_font"
            android:letterSpacing="0.01"
            android:text="초코와"
            android:textColor="@color/input_hint"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_map_rounded"
            android:clipToOutline="true">

            <com.naver.maps.map.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/dayTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            app:tabGravity="start"
            app:tabIndicatorColor="@color/accent"
            app:tabIndicatorFullWidth="false"
            app:tabMode="scrollable"
            app:tabPaddingStart="0dp"
            app:tabRippleColor="@null"
            app:tabSelectedTextColor="@color/input_hint"
            app:tabTextAppearance="@style/TextAppearance.PawMap.Tab"
            app:tabTextColor="@color/input_hint" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ADADAE" />

        <TextView
            android:id="@+id/tvDayDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/nps_font"
            android:letterSpacing="0.01"
            android:text="7.27 (월)"
            android:textColor="@color/input_hint"
            android:textSize="15sp" />

        <!-- Empty state -->
        <TextView
            android:id="@+id/emptyCard"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_dashed"
            android:fontFamily="@font/nps_font"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:text="@string/empty_day"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Day place items are added here -->
        <LinearLayout
            android:id="@+id/dayContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/btnAddPlace"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_outline_button_accent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_add"
                app:tint="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/nps_font"
                android:letterSpacing="0.01"
                android:text="@string/add_place"
                android:textColor="@color/accent"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>