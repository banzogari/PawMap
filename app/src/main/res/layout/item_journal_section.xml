<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="26dp">

    <TextView
        android:id="@+id/tvDayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nps_font"
        android:text="Day 1 · 7.20 (월)"
        android:textColor="@color/input_hint"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/photoBox"
        android:layout_width="match_parent"
        android:layout_height="196dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_photo_journal"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/photoPlaceholder"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_image"
            app:tint="@color/accent" />

        <ImageView
            android:id="@+id/photoImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvMemo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/nps_font"
        android:lineSpacingExtra="9dp"
        android:text="기록된 메모가 없어요"
        android:textColor="@color/input_hint"
        android:textSize="13sp" />
</LinearLayout>