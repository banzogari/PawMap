<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="15dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nps_font"
        android:text="새 목록"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_outline"
        android:fontFamily="@font/nps_font"
        android:hint="목록 이름"
        android:inputType="text"
        android:maxLength="20"
        android:maxLines="1"
        android:paddingHorizontal="13dp"
        android:textColor="@color/text_primary"
        android:textColorHint="#ADADAE"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/nps_font"
        android:text="0/20"
        android:textColor="#ADADAE"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_outline"
            android:fontFamily="@font/nps_font"
            android:gravity="center"
            android:text="취소"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnCreate"
            android:layout_width="0dp"
            android:layout_height="35dp"
            android:layout_marginStart="15dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_btn_primary"
            android:fontFamily="@font/nps_font"
            android:gravity="center"
            android:text="만들기"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>